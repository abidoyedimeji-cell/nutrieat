# Copy to .env.local and fill in. Never commit real secrets.

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server-only — never expose to the browser

# Survey (Google Form embed URL used in MVP, e.g. https://docs.google.com/forms/d/e/XXXX/viewform?embedded=true)
NEXT_PUBLIC_SURVEY_EMBED_URL=

# Stripe (server-only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PDF=
STRIPE_PRICE_ID_HARDBACK=
STRIPE_PRICE_ID_BUNDLE=

# Email (Resend — verified sending domain: oladimejisultan.org)
RESEND_API_KEY=
EMAIL_FROM=Breakfast Superfood <orders@oladimejisultan.org>
SUPPORT_EMAIL=support@oladimejisultan.org

# Admin CMS access — comma-separated allowlist, server-side only (never NEXT_PUBLIC).
ADMIN_EMAILS=abidoyedimeji@gmail.com
