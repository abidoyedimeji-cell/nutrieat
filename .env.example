# Copy to .env.local and fill in. Never commit real secrets.

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server-only — never expose to the browser

# Survey (Google Form embed URL used in MVP, e.g. https://docs.google.com/forms/d/e/XXXX/viewform?embedded=true)
NEXT_PUBLIC_SURVEY_EMBED_URL=

# --- Not used in Sprint 1 (commerce/email land in later sprints) ---
